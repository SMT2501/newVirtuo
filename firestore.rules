rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function internalUser() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff'];
    }

    function adminUser() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function accountMember(accountId) {
      return signedIn() && exists(/databases/$(database)/documents/accounts/$(accountId)/members/$(request.auth.uid));
    }

    function legacyClient(clientId) {
      return signedIn() && clientId == request.auth.uid;
    }

    // Legacy records predate account membership. Once a document is linked to
    // an account, ownerId must never bypass that account's access checks.
    function legacyDocumentOwner(data) {
      return signedIn()
        && !('accountId' in data)
        && data.ownerId == request.auth.uid;
    }

    function documentRecipient(data) {
      return signedIn()
        && data.clientVisible == true
        && accountMember(data.accountId)
        && request.auth.uid in data.recipientIds;
    }

    function projectVisitor(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && exists(/databases/$(database)/documents/projects/$(projectId)/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.shareEnabled == true
        && get(/databases/$(database)/documents/projects/$(projectId)/access/$(request.auth.uid)).data.expiresAt > request.time
        && get(/databases/$(database)/documents/projects/$(projectId)/access/$(request.auth.uid)).data.shareVersion == get(/databases/$(database)/documents/projects/$(projectId)).data.shareVersion;
    }

    function projectDocumentVisitor(data) {
      return signedIn()
        && data.clientVisible == true
        && ('projectId' in data)
        && data.projectId != null
        && projectVisitor(data.projectId);
    }

    function documentShareVisitor(documentId, data) {
      return signedIn()
        && data.clientVisible == true
        && data.signingShareEnabled == true
        && data.needsSignature == true
        && data.contentType == 'application/pdf'
        && data.storagePath != null
        && data.status in ['awaiting_signature', 'signed']
        && (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt > request.time)
        && exists(/databases/$(database)/documents/documents/$(documentId)/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/documents/$(documentId)/access/$(request.auth.uid)).data.expiresAt > request.time
        && get(/databases/$(database)/documents/documents/$(documentId)/access/$(request.auth.uid)).data.shareVersion == data.signingShareVersion;
    }

    match /checkupLeads/{leadId} {
      allow read: if internalUser();
      allow create, update, delete: if false;
    }
    match /_checkupRateLimits/{recordId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || internalUser());
      allow create: if (adminUser() && request.resource.data.role in ['client', 'staff', 'admin'])
        || (internalUser() && request.resource.data.role == 'client');
      allow update: if adminUser();
      allow delete: if adminUser();
    }

    match /accounts/{accountId} {
      allow read: if internalUser() || accountMember(accountId);
      allow create, update, delete: if internalUser();

      match /members/{memberId} {
        allow read: if internalUser() || request.auth.uid == memberId;
        allow create, update, delete: if internalUser();
      }
    }

    match /tasks/{taskId} {
      allow read: if internalUser()
        || (resource.data.clientVisible == true && accountMember(resource.data.accountId))
        || projectDocumentVisitor(resource.data);
      allow create, update, delete: if internalUser();
    }

    match /documents/{documentId} {
      allow read: if internalUser()
        || legacyDocumentOwner(resource.data)
        || (resource.data.clientVisible == true && documentRecipient(resource.data))
        || projectDocumentVisitor(resource.data)
        || documentShareVisitor(documentId, resource.data);
      allow create: if internalUser()
        || legacyDocumentOwner(request.resource.data)
        || (accountMember(request.resource.data.accountId) && request.resource.data.uploaderId == request.auth.uid);
      allow update: if internalUser()
        || (
          documentRecipient(resource.data)
          && resource.data.status == 'awaiting_signature'
          && request.resource.data.status == 'declined'
          && request.resource.data.declinedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'declinedAt', 'declinedBy', 'declineReason'
          ])
        )
        ;
      allow delete: if internalUser();
    }

    match /documentEvents/{eventId} {
      allow read: if internalUser()
        || request.auth.uid == resource.data.actorId
        || projectVisitor(get(/databases/$(database)/documents/documents/$(resource.data.documentId)).data.projectId)
        || documentShareVisitor(resource.data.documentId, get(/databases/$(database)/documents/documents/$(resource.data.documentId)).data);
      allow create: if internalUser()
        || (
          signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['accountId', 'documentId', 'eventType', 'actorId', 'createdAt'])
          && request.resource.data.eventType in ['viewed', 'downloaded', 'declined']
        && request.resource.data.createdAt == request.time
        && request.resource.data.accountId == get(/databases/$(database)/documents/documents/$(request.resource.data.documentId)).data.accountId
        && get(/databases/$(database)/documents/documents/$(request.resource.data.documentId)).data.clientVisible == true
        && accountMember(get(/databases/$(database)/documents/documents/$(request.resource.data.documentId)).data.accountId)
        && request.auth.uid in get(/databases/$(database)/documents/documents/$(request.resource.data.documentId)).data.recipientIds
        && (
          request.resource.data.eventType in ['viewed', 'downloaded']
          || (
            request.resource.data.eventType == 'signed'
            && get(/databases/$(database)/documents/documents/$(request.resource.data.documentId)).data.status == 'signed'
            && get(/databases/$(database)/documents/documents/$(request.resource.data.documentId)).data.signedBy == request.auth.uid
          )
          || (
            request.resource.data.eventType == 'declined'
            && get(/databases/$(database)/documents/documents/$(request.resource.data.documentId)).data.status == 'declined'
            && get(/databases/$(database)/documents/documents/$(request.resource.data.documentId)).data.declinedBy == request.auth.uid
          )
        )
        )
        || (
          signedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['accountId', 'documentId', 'eventType', 'actorId', 'createdAt'])
          && request.resource.data.eventType in ['viewed', 'downloaded']
          && request.resource.data.createdAt == request.time
          && projectVisitor(get(/databases/$(database)/documents/$(request.resource.data.documentId)).data.projectId)
        )
        || (
          signedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['accountId', 'documentId', 'eventType', 'actorId', 'createdAt'])
          && request.resource.data.eventType in ['viewed', 'downloaded']
          && request.resource.data.createdAt == request.time
          && documentShareVisitor(request.resource.data.documentId, get(/databases/$(database)/documents/documents/$(request.resource.data.documentId)).data)
        );
      allow update, delete: if false;
    }

    match /documents/{documentId}/versions/{versionId} {
      allow read, create: if internalUser();
      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow read: if internalUser()
        || legacyClient(resource.data.clientId)
        || (resource.data.clientVisible == true && accountMember(resource.data.accountId))
        || (resource.data.clientVisible == true && projectVisitor(projectId));
      allow write: if internalUser();

      match /access/{accessId} {
        allow read: if request.auth.uid == accessId || internalUser();
        allow write: if false;
      }
    }

    match /invoices/{invoiceId} {
      allow read: if internalUser()
        || legacyClient(resource.data.clientId)
        || (resource.data.clientVisible == true && accountMember(resource.data.accountId));
      allow write: if internalUser();
    }

    match /activities/{activityId} {
      allow read: if internalUser()
        || (resource.data.clientVisible == true && accountMember(resource.data.accountId))
        || projectDocumentVisitor(resource.data);
      allow create: if internalUser()
        || (
          accountMember(request.resource.data.accountId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.clientVisible == true
          && request.resource.data.type == 'client_document_uploaded'
          && request.resource.data.message == 'A client document was uploaded for the Virtuo team.'
          && request.resource.data.keys().hasOnly([
            'accountId', 'type', 'message', 'actorId', 'clientVisible', 'createdAt'
          ])
        );
      allow update, delete: if internalUser();
    }

    match /projectNotes/{projectId} {
      allow read, create, update, delete: if internalUser();
    }

    match /proposals/{recordId} {
      allow read: if internalUser() || legacyClient(resource.data.clientId);
      allow create, update, delete: if internalUser();
    }

    match /funding/{recordId} {
      allow read, write: if internalUser();
    }

    match /internalDocuments/{recordId} {
      allow read, write: if internalUser();
    }

    match /staff/{recordId} {
      allow read: if internalUser();
      allow create, update, delete: if adminUser();
    }
  }
}
