rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function internalUser() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff'];
    }

    function adminUser() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function accountMember(accountId) {
      return signedIn() && firestore.exists(/databases/(default)/documents/accounts/$(accountId)/members/$(request.auth.uid));
    }

    function documentRecipient(accountId, documentId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/documents/$(documentId))
        && accountMember(accountId)
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.accountId == accountId
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.clientVisible == true
        && request.auth.uid in firestore.get(/databases/(default)/documents/documents/$(documentId)).data.recipientIds;
    }

    function pendingSigner(accountId, documentId) {
      return documentRecipient(accountId, documentId)
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.accountId == accountId
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.status == 'awaiting_signature';
    }

    function projectVisitor(projectId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/projects/$(projectId))
        && firestore.exists(/databases/(default)/documents/projects/$(projectId)/access/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.shareEnabled == true
        && firestore.get(/databases/(default)/documents/projects/$(projectId)/access/$(request.auth.uid)).data.expiresAt > request.time
        && firestore.get(/databases/(default)/documents/projects/$(projectId)/access/$(request.auth.uid)).data.shareVersion == firestore.get(/databases/(default)/documents/projects/$(projectId)).data.shareVersion;
    }

    function projectDocumentVisitor(accountId, documentId) {
      return firestore.exists(/databases/(default)/documents/documents/$(documentId))
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.accountId == accountId
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.clientVisible == true
        && projectVisitor(firestore.get(/databases/(default)/documents/documents/$(documentId)).data.projectId);
    }

    function documentShareVisitor(accountId, documentId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/documents/$(documentId))
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.accountId == accountId
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.clientVisible == true
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.signingShareEnabled == true
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.needsSignature == true
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.contentType == 'application/pdf'
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.storagePath != null
        && firestore.get(/databases/(default)/documents/documents/$(documentId)).data.status in ['awaiting_signature', 'signed']
        && (!('expiresAt' in firestore.get(/databases/(default)/documents/documents/$(documentId)).data) || firestore.get(/databases/(default)/documents/documents/$(documentId)).data.expiresAt == null || firestore.get(/databases/(default)/documents/documents/$(documentId)).data.expiresAt > request.time)
        && firestore.exists(/databases/(default)/documents/documents/$(documentId)/access/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/documents/$(documentId)/access/$(request.auth.uid)).data.expiresAt > request.time
        && firestore.get(/databases/(default)/documents/documents/$(documentId)/access/$(request.auth.uid)).data.shareVersion == firestore.get(/databases/(default)/documents/documents/$(documentId)).data.signingShareVersion;
    }

    match /accounts/{accountId}/documents/{documentId}/{fileName} {
      allow read: if internalUser() || documentRecipient(accountId, documentId) || projectDocumentVisitor(accountId, documentId) || documentShareVisitor(accountId, documentId);
      allow create: if internalUser()
        || (accountMember(accountId) && fileName.matches('client-.*'))
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        ];
      allow update: if internalUser();
      allow delete: if internalUser();
    }

    match /clients/{userId}/documents/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || internalUser());
      allow write: if signedIn() && (request.auth.uid == userId || internalUser())
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'];
      allow delete: if signedIn() && (request.auth.uid == userId || internalUser());
    }
  }
}
