modules = ["nodejs-20", "web", "python-base-3.13"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 pnpm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8042
externalPort = 5000

[[ports]]
localPort = 8313
externalPort = 4200

[[ports]]
localPort = 8446
externalPort = 5173

[[ports]]
localPort = 8459
externalPort = 3000

[[ports]]
localPort = 8797
externalPort = 3002

[[ports]]
localPort = 8998
externalPort = 3003

[[ports]]
localPort = 23636
externalPort = 3001

[deployment]
deploymentTarget = "static"
build = ["pnpm", "run", "build"]
publicDir = "dist/public"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
